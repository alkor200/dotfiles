#!/bin/bash
# Runs again whenever the Brewfile changes. Hash: {{ include "Brewfile" | sha256sum }}
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [[ -x "$b" ]] && eval "$("$b" shellenv)" && break
    done
fi
command -v brew >/dev/null 2>&1 || { echo "Homebrew is missing - run install.sh first." >&2; exit 1; }

# Third-party taps: trust only the specific packages used, not entire taps
brew tap nikitabobko/tap
brew tap felixkratz/formulae
brew tap int128/kubelogin
brew trust --cask nikitabobko/tap/aerospace
brew trust --formula felixkratz/formulae/borders
brew trust --formula int128/kubelogin/kubelogin

brew bundle --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
