#!/bin/bash
# Sets zsh as the login shell (asks for the password once).
set -euo pipefail

zsh_path="$(command -v zsh || true)"
[[ -n "$zsh_path" ]] || { echo "zsh not found - install it first." >&2; exit 1; }

{{ if eq .chezmoi.os "darwin" -}}
current="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')"
{{ else -}}
current="$(getent passwd "$(id -un)" | cut -d: -f7)"
{{ end -}}
if [[ "$current" != "$zsh_path" ]]; then
    echo "Login shell is $current - switching to $zsh_path."
    user="$(id -un)"
    if [[ "$(id -u)" -eq 0 ]]; then
        chsh -s "$zsh_path" "$user"
    elif sudo -n chsh -s "$zsh_path" "$user" 2>/dev/null; then
        :
    elif [[ -r /dev/tty ]]; then
        sudo chsh -s "$zsh_path" "$user" < /dev/tty || \
            echo "Could not switch login shell - run 'sudo chsh -s $zsh_path $user' manually." >&2
    else
        echo "No controlling terminal - run 'sudo chsh -s $zsh_path $user' manually." >&2
    fi
fi
